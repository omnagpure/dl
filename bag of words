# 1. Import necessary packages
import numpy as np
import tensorflow as tf
from tensorflow.keras.preprocessing.text import Tokenizer

# 2. Prepare the text data
sentences = [
    "the cat is sitting",
    "the dog is running",
    "the cat is running"
]

# 3. Convert words into numbers
tokenizer = Tokenizer()
tokenizer.fit_on_texts(sentences)

vocabulary_size = len(tokenizer.word_index) + 1

sequences = tokenizer.texts_to_sequences(sentences)

print("Word Index:", tokenizer.word_index)

# 4. Generate CBOW training data
context_words = []
target_words = []

for sequence in sequences:
    for i in range(1, len(sequence) - 1):
        context = [sequence[i-1], sequence[i+1]]
        target = sequence[i]

        context_words.append(context)
        target_words.append(target)

context_words = np.array(context_words)
target_words = np.array(target_words)

# 5. Define the CBOW model
model = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(2,)),
    tf.keras.layers.Embedding(vocabulary_size, 10),
    tf.keras.layers.GlobalAveragePooling1D(),
    tf.keras.layers.Dense(vocabulary_size, activation='softmax')
])

# 6. Compile the model
model.compile(
    optimizer='adam',
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

# 7. Train the model
model.fit(
    context_words,
    target_words,
    epochs=100,
    verbose=1
)

