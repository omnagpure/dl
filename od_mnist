# 1. Import necessary packages
import tensorflow as tf
import matplotlib.pyplot as plt

# 2. Load MNIST dataset
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()

# Select only digits 0 and 1
train = (y_train == 0) | (y_train == 1)
test = (y_test == 0) | (y_test == 1)

x_train = x_train[train]
y_train = y_train[train]

x_test = x_test[test]
y_test = y_test[test]

# 3. Preprocess images
x_train = x_train / 255.0
x_test = x_test / 255.0

# Convert grayscale to RGB and resize
x_train = tf.image.grayscale_to_rgb(
    tf.convert_to_tensor(x_train[..., None])
)
x_test = tf.image.grayscale_to_rgb(
    tf.convert_to_tensor(x_test[..., None])
)

x_train = tf.image.resize(x_train, (96, 96))
x_test = tf.image.resize(x_test, (96, 96))

# 4. Load pre-trained MobileNetV2
base_model = tf.keras.applications.MobileNetV2(
    input_shape=(96, 96, 3),
    include_top=False,
    weights='imagenet'
)

# Freeze pre-trained layers
base_model.trainable = False

# 5. Add custom classifier
model = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(96, 96, 3)),
    base_model,
    tf.keras.layers.GlobalAveragePooling2D(),
    tf.keras.layers.Dense(64, activation='relu'),
    tf.keras.layers.Dense(1, activation='sigmoid')
])

# 6. Compile model
model.compile(
    optimizer='adam',
    loss='binary_crossentropy',
    metrics=['accuracy']
)

# 7. Train the model
history = model.fit(
    x_train, y_train,
    epochs=5,
    batch_size=32
)

# 8. Evaluate model
loss, accuracy = model.evaluate(x_test, y_test)

print("Test Accuracy:", accuracy * 100, "%")

# 9. Plot accuracy
plt.plot(history.history['accuracy'])
plt.title('Training Accuracy')
plt.xlabel('Epochs')
plt.ylabel('Accuracy')
plt.show()
