
# 1. Import required libraries
import tensorflow as tf
import numpy as np
import matplotlib.pyplot as plt

# 2. Load MNIST dataset
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()

# 3. Select only digit 0 for training
x_train = x_train[y_train == 0]

# 4. Normalize the images
x_train = x_train / 255.0
x_test = x_test / 255.0

# 5. Flatten the images
x_train = x_train.reshape(-1, 784)
x_test = x_test.reshape(-1, 784)

# 6. Build the Encoder
encoder = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(784,)),
    tf.keras.layers.Dense(128, activation='relu'),
    tf.keras.layers.Dense(32, activation='relu')
])

# 7. Build the Decoder
decoder = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(32,)),
    tf.keras.layers.Dense(128, activation='relu'),
    tf.keras.layers.Dense(784, activation='sigmoid')
])

# 8. Build the Autoencoder
autoencoder = tf.keras.Sequential([encoder, decoder])

# 9. Compile the model
autoencoder.compile(
    optimizer='adam',
    loss='mse',
    metrics=['mae']
)

# 10. Train the Autoencoder
history = autoencoder.fit(
    x_train, x_train,
    epochs=5,
    batch_size=256,
    validation_split=0.1
)

# 11. Reconstruct test images
reconstructed = autoencoder.predict(x_test)

# 12. Calculate reconstruction error
error = np.mean(np.square(x_test - reconstructed), axis=1)

# 13. Set anomaly threshold
threshold = np.percentile(error[:1000], 95)

# 14. Detect anomalies
predictions = error > threshold

# 15. Display results
print("Threshold:", threshold)
print("Normal Images:", np.sum(predictions == False))
print("Anomalous Images:", np.sum(predictions == True))



